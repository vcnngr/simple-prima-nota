# Backend Environment Variables

# Ambiente
NODE_ENV=development

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prima_nota
DB_USER=postgres
DB_PASSWORD=password123

# JWT Secret (CAMBIARE IN PRODUZIONE!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug

# Notifiche email (blocco W4). Senza SMTP_HOST le notifiche restano in coda
# nella tabella `notifiche` e partono quando il trasporto viene configurato.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Simple Prima Nota <no-reply@example.com>
NOTIFICHE_INTERVALLO_MS=30000
NOTIFICHE_NON_LETTI_ORE=4
NOTIFICHE_MAX_TENTATIVI=5
NOTIFICHE_BACKOFF_MS=60000
