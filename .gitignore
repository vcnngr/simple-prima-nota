backend/.env
frontend/.env
backend/.DS_Store
frontend/.DS_Store
frontend/src/.DS_Store
frontend/src/pages/.DS_Store

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
frontend/build/

# Database exports and backups
*.sql
database_export*.sql
*.dump

# ...ma schema e migrazioni sono codice sorgente, non backup: senza queste
# eccezioni ogni nuova migration resta fuori dal repo senza che nessuno se ne accorga.
!database/init.sql
!database/migrations/*.sql
# e la loro copia nel chart Helm (scripts/sincronizza-helm-db.sh), che il job
# delle migrazioni legge dalla ConfigMap.
!helm-chart/files/database/*.sql
!helm-chart/files/database/migrations/*.sql

# Logs
*.log
backend/logs/
frontend/logs/

# Temporary files
*.tmp
*.temp
/tmp/

# Allegati della chat caricati in sviluppo
backend/uploads/

# K5: segreti di docker compose (JWT_SECRET)
/.env
